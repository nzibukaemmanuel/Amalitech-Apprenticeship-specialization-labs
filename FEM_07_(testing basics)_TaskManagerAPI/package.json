{
  "name": "task-manager-api-client",
  "version": "1.0.0",
  "description": "ES6+ Task Manager API Client using JSONPlaceholder",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "web": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watch",
    "test:legacy": "node tests/smoke-test.js && node tests/integration-test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
